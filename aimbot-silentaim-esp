local function createESP(player)
	if player == LocalPlayer then return end
	local char = player.Character
	if not char then return end
	
	local highlight = Instance.new("Highlight")
	highlight.Adornee = char
	highlight.FillColor = Color3.fromRGB(255, 50, 50)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.4
	highlight.OutlineTransparency = 0
	highlight.Enabled = espEnabled
	highlight.Parent = char
	
	local billboard = Instance.new("BillboardGui")
	billboard.Adornee = char
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 3.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = espEnabled
	billboard.Parent = char
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = player.Name
	label.TextColor3 = Color3.fromRGB(255, 255 255)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = billboard
	
	playerESP[player] = {highlight = highlight, billboard = billboard}
	
	char:WaitForChild("HumanoidRootPart").AncestryChanged:Connect(function()
		if not char.Parent then
			removeESP(player)
		end
	end)
end

local function removeESP(player)
	if playerESP[player] then
		if playerESP[].highlight then
			playerESP[player].highlightDestroy()
		end
		if playerESP[player].bill then
			playerESP[player].billboard:Destroy		end
		playerESP[player] = nil

end

local function updateESP()
	for player, esp in pairs(playerESP) do
		if esp.highlight then
	esp.highlight.Enabled = espEnabled
		end
		if.billboard then
			esp.billboard.Enabled espEnabled
		end
	end
end

local function getosestTarget()
	local closest = nil
	local closestDist = mathuge
	local mousePos = Vector2.new(UserInputService:MouseLocation().X, UserInputService:GetMouseLocation().Y)
	
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local char = player.Character
			local root = char.HumanoidRootPart
			local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
			
			if onScreen then
				local dist = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
				if dist < closestDist then
					closestDist = dist
					closest = player
				end
			end
		end
	end
	
	return closestend

local function aimbot()
	local target = getClosest()
