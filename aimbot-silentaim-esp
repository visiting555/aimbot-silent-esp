local playerESP = {}
local function removeESP(player)
    if playerESP[player] then
        if playerESP[player].highlight then
            playerESP[player].highlight:Destroy()
        end
        if playerESP[player].billboard then
            playerESP[player].billboard:Destroy()
        end
        player = nil
    end
end

local function createESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Adornee = char
    highlight.F3.fromRGB(255, 50, 50)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.Enabled    highlight.Parent = char
    
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = char
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0,  0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = espEnabled
    billboard.Parent = char
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = label.Text = player.Name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard
    
    playerESP[player] = {board = billboard}
end

local function updateESP()
    for player, esp in pairs(playerESP) do
        if esp.highlight then
            esp.highlight.Enabled = espEnabled
        end
        if esp.billboard then
            esp.billboard.Enabled = espEnabled
 end
end

local function getClosestTarget()
    local closest = nil
    local closestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Local.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            local root = char.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
            
            if onScreen then
                local dist = (Vector2.new, mousePos.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    
    return closest
end

local function aimbot()
    local target = getClosestTarget()
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local root = target.Character.HumanoidRootPart
        local lookAt = CFrame.new(Camera.CFrame.Position, root.Position)
        Camera.CFrame = lookAt
    end
end

local function enableGodmode()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge
        humanoid.BreakJointsOnDeath = false
        humanoid.Parent = nil
        wait()
        humanoid.Parent = char
        playerGodmode[LocalPlayer] = humanoid
    end
end

local function disableGodmode()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass    if humanoid then
        humanoid.MaxHealth = 100
        humanoid.Health = 100
        humanoid.BreakJointsOnDeath = true
    end
    if playerGodmode[LocalPlayer] then
        playerGodmode[LocalPlayer] = nil
    end
end

local function toggleGodmode()
    godmodeEnabled = not godmodeEnabled
    if godmodeEnabled then
        enableGodmode()
    else
        disableGodmode()
    end
    return godmodeEnabled
end

