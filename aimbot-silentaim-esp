-- ANA OYUN DÖNGÜSÜ (RenderStepped)
RunService.RenderStepped:Connect(function()
    -- 1. ESP Güncelleme
    updateESP()

    -- 2. Aimlock Takibi
    if aimbotEnabled then
        local target = getBestTarget()
        if target then
            -- Kamerayı Lerp (yumuşak geçiş) ile hedefe kilitler
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), 0.4)
        end
    end

    -- 3. Godmode Koruma
    if godmodeEnabled then
        applyGodmode()
    end
end)
