-- --- AIMBOT MANTIĞI (BAKIŞ AÇISI VE EN YAKIN HEDEF) ---
local function getBestTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

    local myPos = myChar.HumanoidRootPart.Position

    local threatTarget = nil
    local threatPriority = -1

    local closestTarget = nil
    local closestDist = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                local root = player.Character.HumanoidRootPart
                local screenPos, onScreen = Camera:WorldToScreenPoint(root.Position)

                if onScreen then
                    -- 1. Bize Doğru Bakıyor mu Kontrolü (Threat Detection)
                    local lookVector = root.CFrame.LookVector
                    local directionToMe = (myPos - root.Position).Unit
                    local dotProduct = lookVector:Dot(directionToMe) -- 1'e ne kadar yakınsa o kadar bize bakıyordur

                    if dotProduct > 0.7 then -- Bize oldukça düz bakıyor demektir (~45 derece açı)
                        if dotProduct > threatPriority then
                            threatPriority = dotProduct
                            threatTarget = root
                        end
                    end

                    -- 2. Fareye En Yakınlık Hesabı
                    local dist = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestTarget = root
                    end
                end
            end
        end
    end

    -- Eğer bize bakan/tehdit oluşturan biri varsa İLK ONA kilitlenir
    if threatTarget then
        return threatTarget
    end

    -- Yoksa fareye en yakın olana kilitlenir
    return closestTarget
end

